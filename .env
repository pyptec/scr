CLIENT_ID   = pyp_eficiencia_energetica_Alkosto_SAMEE100-PRUEBA
ENDPOINT    = "a6iaynv7vyssn-ats.iot.us-east-1.amazonaws.com" #a2fmzntuuij9yf-ats.iot.us-east-1.amazonaws.com
ROOT_CA     = /home/pi/medidor/cert/RootCA1.pem
PRIVATE_KEY = /home/pi/medidor/cert/private.pem.key
CERTIFICATE = /home/pi/medidor/cert/certificate.pem.crt
TOPIC =       pyp/events # pyp/prueba
TUTOPIC =   tunel/ssh
PORT        = 8883

TIMERCHEQUEOTEMPERATURA=60
TIMERCOLAEVENTOS=60
TIMERMEDICION=600
TIMERPING=120
TIMECHECKUSBETHERNET=600
TIMECHECK_USB_ETHERNET_TIME=6
USAR_HILO_MEDIDOR_10MIN=true

MEDIDOR_ACTIVO=eastron
#MEDIDOR_ACTIVO=meatrol

CONFIGS_ACTIVAS=CFG_EASTRON,CFG_SHT20,CFG_SISTEMA,CFG_PYP_CONNECT

# Rutas de configuración
CFG_EASTRON=/home/pi/SAMEE100/scr/device/eastronSDm630.yml
CFG_MEATROL1=/home/pi/SAMEE100/scr/device/meatrolME337.yml
CFG_MEATROL2=/home/pi/SAMEE100/scr/device/meatrolME3372.yml
CFG_SHT20=/home/pi/SAMEE100/scr/device/sht20.yml

#Ruta de la puerta del medidor
CFG_DOOR=/home/pi/SAMEE100/scr/device/door.yml

# ruta de conexion del sistema a internet
CFG_CONNECT=/home/pi/SAMEE100/scr/device/pyp_Conect.yml

# ruta de las variables del sistema
CFG_SISTEMA=/home/pi/SAMEE100/scr/device/sistema.yml
# Nombres de sección dentro del YAML
CFG_EASTRON_SECTION=samee100
CFG_MEATROL1_SECTION=meatrolME337
CFG_MEATROL2_SECTION=meatrolME337_2
CFG_SHT20_SECTION=sht20_sensor

CFG_DOOR_SECTION=door_sensor
CFG_CONNECT_SECTION=pyp_connect
CFG_SISTEMA_SECTION=variables_del_sistema