CLIENT_ID=pyp_eficiencia_energetica_LPS_SAMEE200
ENDPOINT="a6iaynv7vyssn-ats.iot.us-east-1.amazonaws.com"
ROOT_CA=/home/pi/medidor/cert/RootCA1.pem
PRIVATE_KEY=/home/pi/medidor/cert/private.pem.key
CERTIFICATE=/home/pi/medidor/cert/certificate.pem.crt
TOPIC=pyp/events
TUTOPIC=tunel/ssh
PORT=8883

TIMERCHEQUEOTEMPERATURA=60
TIMERCOLAEVENTOS=60
TIMERMEDICION=600
TIMERPING=120
TIMECHECKUSBETHERNET=600
TIMECHECK_USB_ETHERNET_TIME=6
USAR_HILO_MEDIDOR_10MIN=true

# =========================
# SAMEE200 / BASE LOCAL
# =========================
DB_PATH=/home/pi/SAMEE200/scr/data/samee200.db

# =========================
# CONFIGURACIÓN GENERAL
# =========================
GATEWAY_CONFIG=CFG_CONNECT

# Rol principal para dashboard industrial
DASHBOARD_MEDIDOR_TOTAL=CFG_TOTALIZADOR
DASHBOARD_MEDIDOR_PROCESO=CFG_PROCESO

# Compatibilidad con funciones tipo SAMEE100
DASHBOARD_MEDIDOR_CONFIG=CFG_TOTALIZADOR

# =========================
# CONFIGURACIONES ACTIVAS
# =========================
CONFIGS_ACTIVAS=CFG_TOTALIZADOR,CFG_PROCESO,CFG_SHT20,CFG_SISTEMA,CFG_CONNECT,CFG_DOOR

# =========================
# RUTAS YAML
# =========================
# IMPORTANTE:
# meatrolME3372 = TOTALIZADOR
# meatrolME337  = PROCESO AOKI / COMPRESOR

CFG_TOTALIZADOR=/home/pi/SAMEE200/scr/device/meatrolME3372.yml
CFG_PROCESO=/home/pi/SAMEE200/scr/device/meatrolME337.yml

CFG_MEATROL1=/home/pi/SAMEE200/scr/device/meatrolME337.yml
CFG_MEATROL2=/home/pi/SAMEE200/scr/device/meatrolME3372.yml

CFG_EASTRON=/home/pi/SAMEE100/scr/device/eastronSDm630.yml

CFG_SHT20=/home/pi/SAMEE200/scr/device/sht20.yml
CFG_SISTEMA=/home/pi/SAMEE200/scr/device/sistema.yml
CFG_CONNECT=/home/pi/SAMEE200/scr/device/pyp_Conect.yml
CFG_DOOR=/home/pi/SAMEE200/scr/device/door.yml

# =========================
# SECCIONES YAML
# =========================
CFG_TOTALIZADOR_SECTION=meatrolME337_2
CFG_PROCESO_SECTION=meatrolME337

CFG_MEATROL1_SECTION=meatrolME337
CFG_MEATROL2_SECTION=meatrolME337_2

CFG_EASTRON_SECTION=eastronSDm630

CFG_SHT20_SECTION=sht20_sensor
CFG_SISTEMA_SECTION=variables_del_sistema
CFG_CONNECT_SECTION=pyp_connect
CFG_DOOR_SECTION=door_sensor

# =========================
# KPI ENERGÉTICOS
# =========================
TARIFA_KWH=950
FACTOR_CO2_KG_KWH=0.164
MAX_DELTA_KWH_MUESTRA=200

# =========================
# PRODUCCIÓN SIMULADA AOKI
# =========================
PRODUCCION_SIMULADA=true
PRODUCCION_MIN_DIA=29000
PRODUCCION_MAX_DIA=32000
PRODUCTO_BASE=Botella_1L
LINEA_PRODUCCION=AOKI

# =========================
# ISO 50001 / LÍNEA BASE
# =========================
LINEA_BASE_VARIABLE_X=envases
LINEA_BASE_VARIABLE_Y=kwh_totalizador
ENPI_PRINCIPAL=kwh_por_1000_envases

# =========================
# MANTENIMIENTO
# =========================
MTTO_EQUIPO_PRINCIPAL=AOKI
MTTO_TIEMPO_PROGRAMADO_DIA_H=24