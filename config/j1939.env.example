# El valor false no inicia el servicio, no abre serial y no activa polling web.
J1939_ENABLED=false
J1939_TRANSPORT=serial
J1939_SERIAL_DEVICE=
J1939_SERIAL_BAUDRATE=115200
J1939_BITRATE=250000
J1939_SIGNAL_CONFIG=config/j1939_signals.yml
J1939_HEARTBEAT_SECONDS=600
J1939_RECENT_FRAME_LIMIT=200
J1939_LOCAL_API_PORT=8765
J1939_CAPTURE_DIR=data/j1939_captures
J1939_CAPTURE_MAX_DURATION_SECONDS=3600
J1939_CAPTURE_MAX_FILE_MB=50
J1939_CAPTURE_MAX_FILES=20
J1939_CAPTURE_QUEUE_SIZE=2000
# Solo para J1939_TRANSPORT=replay. También puede usarse --replay RUTA.
J1939_REPLAY_FILE=
